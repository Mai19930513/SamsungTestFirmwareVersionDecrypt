# 复制需要的项目到现有 .env；不要覆盖已有密钥。
# auto 合并 models.txt 和现有 JSON；file 仅使用 models.txt；mysql 读取 models 表。
FW_MODEL_SOURCE=auto
FW_MODELS_FILE=models.txt
FW_OUTPUT_DIR=.
FW_DATA_DIR=data
FW_CACHE_DIR=.cache/firmware
FW_DB_BACKEND=sqlite
# local: 本地 SQLite；cloud: 云 MySQL；both: 双写，云失败先本地保留并补传。
# 优先级：命令行 --storage > FW_STORAGE > 兼容的 FW_DB_BACKEND。
FW_STORAGE=local

# MySQL 可选；也兼容 HOST / DBUSER / PASSWORD / DATABASE。
FW_MYSQL_HOST=
FW_MYSQL_PORT=3306
FW_MYSQL_USER=
FW_MYSQL_PASSWORD=
FW_MYSQL_DATABASE=
# 留空使用系统 CA，始终验证 TLS 证书与主机名。
FW_MYSQL_SSL_CA=

FW_IO_WORKERS=8
FW_CPU_WORKERS=4
FW_CONNECT_TIMEOUT=5
FW_READ_TIMEOUT=20
FW_RETRIES=2
FW_CACHE_SECONDS=300
FW_SEARCH_CACHE_HOURS=24
FW_DOWNLOAD_CACHE_HOURS=6

# 每个机型/地区每轮的候选数量和时间上限；bounded 自动保存断点，下次续搜。
# 哈希列表/正式版/范围变化会重搜；--force 可手动从头搜索。
FW_MAX_CANDIDATES=5000000
FW_MAX_SECONDS=120
FW_HISTORY_YEARS=4
FW_MODEM_LIMIT=12
# 留空自动推导；非空为确切的字符集合，例如 YZ、456、BCZ。
FW_YEAR_CODES=
FW_BOOTLOADER_CODES=
FW_UPDATE_CODES=
FW_MONTH_CODES=ABCDEFGHIJKL
FW_SERIAL_CODES=123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ
# 此为公开的 FOTA 协议参数，不是设备标识。
FW_HMAC_KEY=fcjimts25@%

FW_DOWNLOADS=true
FW_FUS_PROTOCOL=smart
# 可选本地认证参数文件；默认获取已固定提交、校验哈希的公开参数。
FW_FUS_AUTH_FILE=
FW_FUS_AUTH_SHA256=
# legacy 接口可选设备标识映射，必须是本地 JSON；默认不发送 IMEI/序列号。
FW_DEVICE_IDENTITIES_FILE=
FW_TIMELINE=true
# 默认关闭通知，启用后才读取 Telegram 密钥并发送。
FW_NOTIFICATIONS=false
# 群组当前暂停；数据库保存 ID 与发送开关相互独立。
FW_NOTIFY_GROUPS=false
FW_NOTIFY_BATCH_SECONDS=300
FW_NOTIFY_COOLDOWN_SECONDS=1800
FW_NOTIFY_INITIAL=false
FW_NOTIFY_DOWNLOAD_LINK=true
TG_BOT_TOKEN=
# 正整数个人 ID；正式版上线和回滚只发此处。
TG_USER_ID=
# 数据库未保存群组时从此处读取并入库；数据库配置优先。
TG_CHAT_ID=

# GitHub 部署参数：在仓库 Secrets/Variables 中填写，本地普通扫描不读取这一段。
# FW_STATE_KEY 是 Secret，必须为 64 位随机十六进制字符；不要把真实密钥提交到 Git。
FW_STATE_KEY=
FW_PERSIST_STATE=true
FW_STATE_RETENTION_DAYS=30
FW_SCAN_MODE=full
